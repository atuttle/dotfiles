#!/usr/bin/env node
/**
 * CLI utility that scans a text file for non‑printable ASCII characters.
 *
 * Usage: (after you put this file in your PATH and make it executable)
 *   check-ascii <path‑to‑file>
 *
 * For every character whose ASCII code is < 32 or > 126 the script prints:
 *   <10 chars before> <ASCII code> <10 chars after>
 */

const fs = require('fs');
const path = require('path');

function reportBadAscii(input) {
	const PRINTABLE_MIN = 32; // space
	const PRINTABLE_MAX = 126; // tilde (~)

	const safeSlice = (str, start, end) => str.slice(Math.max(0, start), Math.min(str.length, end));

	let lineNumber = 1;
	const badCharCounts = new Map();

	for (let i = 0; i < input.length; i++) {
		const code = input.charCodeAt(i);
		if (code === 10) {
			badCharCounts.set(code, (badCharCounts.get(code) || 0) + 1);
			lineNumber++;
		} else if (code === 13) {
			badCharCounts.set(code, (badCharCounts.get(code) || 0) + 1);
		} else if ((code < PRINTABLE_MIN || code > PRINTABLE_MAX) && code !== 10 && code !== 13) {
			const before = safeSlice(input, i - 10, i);
			const after = safeSlice(input, i + 1, i + 11);
			console.log(`${lineNumber}: ${before} ${code} ${after}`);
			badCharCounts.set(code, (badCharCounts.get(code) || 0) + 1);
		}
	}

	return { badCharCounts };
}

function printUsageAndExit() {
	const scriptName = path.basename(process.argv[1]);
	console.error(`Usage: ${scriptName} <path-to-file>`);
	process.exit(1);
}

// Expect exactly one argument after the script name
if (process.argv.length !== 3) {
	printUsageAndExit();
}

const filePath = process.argv[2];

// Verify that the file exists and is readable
if (!fs.existsSync(filePath)) {
	console.error(`Error: File not found – "${filePath}"`);
	process.exit(1);
}

// Read the file (UTF‑8) – synchronous is fine for a simple CLI tool
let fileContent;
try {
	fileContent = fs.readFileSync(filePath, 'iso-8859-1');
} catch (err) {
	console.error(`Error reading file "${filePath}": ${err.message}`);
	process.exit(1);
}

// GO GO GO GO
const counts = reportBadAscii(fileContent);

// Report unique bad character counts
if (counts.badCharCounts.size > 0) {
	console.log('\n');
	const sortedCodes = Array.from(counts.badCharCounts.keys()).sort((a, b) => a - b);
	for (const code of sortedCodes) {
		console.log(`chr(${code}): ${counts.badCharCounts.get(code)}`);
	}
}
